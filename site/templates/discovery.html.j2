{% set current_page = 'discovery' %}
<!DOCTYPE html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>条件找导师 · 导师库</title>
<style>
main{margin:auto;padding:24px 22px}.intro{max-width:850px;line-height:1.8}.discovery-layout{display:grid;grid-template-columns:320px minmax(0,1fr);gap:24px;align-items:start}.criteria,.results-card,.review-panel{background:white;border:1px solid var(--line);border-radius:8px;padding:20px}.criteria label,.review-panel label{display:block;margin:12px 0 6px;font-size:13px}.criteria input:not([type=checkbox]),.criteria select,.review-panel input:not([type=checkbox]),.review-panel select,.review-panel textarea{padding:9px;width:100%;min-width:0;border:1px solid var(--line)}select[multiple]{height:145px}.mode-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:9px 0}.mode-row select{width:110px}.criteria .check,.review-panel .check{display:flex;gap:7px;align-items:flex-start;line-height:1.6}.actions{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 8px}.note{font-size:12px;line-height:1.7;color:var(--muted)}.results-card{margin-bottom:14px;overflow-wrap:anywhere}.results-card h2{margin:0 0 7px}.checks{list-style:none;padding:0}.checks li{padding:5px 0;line-height:1.7}.state{display:inline-block;border-radius:4px;padding:2px 6px;background:#eef2eb;font-size:12px;margin-right:6px}.state.unknown{background:#fbf0dc;color:#98601d}.state.fail{background:#f8e8e5;color:#9b3627}.evidence{border-left:3px solid var(--line);padding:6px 12px;font-size:13px;line-height:1.7;white-space:pre-wrap}.results-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.review-panel{margin-top:20px}.review-panel textarea{min-height:100px}.error{color:#a32d25}#discovery-message{min-height:28px;line-height:1.7;white-space:pre-wrap}.review-scope{font-weight:600}.badge{font-size:12px;color:var(--muted)}.empty{padding:24px;line-height:1.8;background:white;border:1px dashed var(--line)}
@media(max-width:850px){.discovery-layout{grid-template-columns:1fr}.criteria{padding:16px}.criteria select[multiple]{height:95px}.criteria-fields{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}.criteria-fields .wide{grid-column:1/-1}.mode-row{gap:12px}.results-card{padding:16px}}

#discovery-message:empty{display:none}.intro{margin-bottom:20px}.criteria h2{margin-top:0}.criteria>label:first-of-type{margin-top:0}#advanced-criteria{margin-top:18px;border-top:1px solid var(--line);padding-top:14px}#advanced-criteria summary,.candidate-proof summary{cursor:pointer;color:var(--accent);line-height:1.7}#discovery-results{scroll-margin-top:115px}.research-preview{line-height:1.75;margin:12px 0}.compact-checks{display:flex;flex-wrap:wrap;gap:6px}.compact-checks .state{margin:0}.candidate-proof{margin-top:12px}.candidate-proof .checks{margin-top:8px}.results-card .actions{margin-bottom:0}.results-card h2 a{text-decoration:none}.results-card .actions>a:first-child{font-weight:600}#criteria-dirty{background:#fbf0dc;padding:8px;border-radius:5px}.results-card .badge{display:block;line-height:1.6}.criteria .actions{margin-top:12px}.compare-chosen{background:var(--soft)}
@media(max-width:850px){main{padding-top:14px}main>h1{font-size:25px;margin:14px 0 10px}.intro{font-size:13px;line-height:1.7;margin-top:0}.discovery-layout{gap:18px}.criteria>h2{font-size:18px}.results-card .actions{gap:10px}.results-bar .toolbar{font-size:12px}.toolbar button{padding:6px 8px}}
#criteria-explanation{font-size:12px;line-height:1.7;margin:0 0 16px;color:var(--muted)}#criteria-explanation summary{cursor:pointer}.candidate-application{margin-top:8px}.candidate-application summary{cursor:pointer;color:var(--accent);line-height:1.7}.preview-source{margin:6px 0}.public-email{font-size:13px;line-height:1.7;margin:8px 0}.results-card .badge{margin:0}.results-card .card-primary-actions{margin:14px 0}.candidate-proof .checks li{border-bottom:1px solid var(--line);padding:9px 0}.candidate-proof .checks li:last-child{border-bottom:0}
.school-picker{border:0;padding:0;margin:18px 0;min-width:0}.school-picker legend{font-size:13px;font-weight:600}.school-selection{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:8px 0;font-size:12px}.school-selection button{padding:5px 8px}.school-picker-actions{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.school-picker-actions button{padding:7px 10px}.school-picker-actions button[hidden]{display:none}.school-chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}.school-chips button{font-size:12px;text-align:left;padding:5px 8px;background:var(--soft);overflow-wrap:anywhere}.school-options{max-height:180px;overflow-y:auto;border:1px solid var(--line);border-radius:5px;padding:4px}.criteria .school-option{display:flex;align-items:center;gap:7px;min-height:44px;padding:5px 7px;margin:0;cursor:pointer;line-height:1.5}.school-option:hover,.school-option:focus-within{background:var(--soft)}.school-option[hidden]{display:none!important}.school-option input{flex-shrink:0;width:16px;height:16px}.school-option span{overflow-wrap:anywhere}#school-search-status:empty{display:none}#candidate-order{margin-top:-8px}
#review-project{width:100%;min-width:0;padding:9px}#review-project-goal{overflow-wrap:anywhere}.review-panel{min-width:0;overflow-wrap:anywhere;scroll-margin-top:115px}.review-panel fieldset{min-width:0;border:1px solid var(--line);margin:16px 0;padding:12px}.review-panel legend{font-weight:600;font-size:13px}
#review-panel{margin:0 0 20px}#project-review-evidence{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}#project-review-evidence[hidden]{display:none}#project-review-evidence>p{grid-column:1/-1}#project-review-evidence fieldset{margin:4px 0}#review-panel>h2{margin-top:0}@media(max-width:850px){ #project-review-evidence{grid-template-columns:1fr}}
#project-options{margin:0 0 16px;padding:12px 16px}#project-options>summary,#filter-options>summary{cursor:pointer;color:var(--accent);line-height:1.7}#filter-options{margin-top:14px}#filter-options>summary{font-weight:600;overflow-wrap:anywhere}#filter-options .school-picker{margin-top:12px}
@media(max-width:850px){.intro{margin-bottom:12px}#project-options{margin-bottom:12px}.criteria{padding:12px}.criteria h2{font-size:16px;margin-bottom:6px}.criteria label{margin-top:8px}.search-help{margin:5px 0;font-size:11px}.criteria .actions{margin-top:10px}.criteria>p:last-child{margin-bottom:0}.discovery-layout{gap:12px}.results-bar{margin-bottom:6px}.results-bar .toolbar{margin-top:0}#intent-overview{margin:8px 0}#criteria-explanation{margin-bottom:10px}}
</style>{% include '_ui_head.html.j2' %}</head><body>{% include '_nav.html.j2' %}<main>
<h1>找到值得了解的导师</h1><p class="intro muted">输入导师姓名或研究关键词，先了解研究与官网资料，再对比值得继续联系的导师。招生信息请到具体项目核对。</p>
<div id="discovery-message" role="status" aria-live="polite"></div>
<p id="unit-context" class="note" hidden></p><button id="clear-unit-context" type="button" hidden>清除院系范围</button>
<details id="project-options" class="review-panel"><summary id="project-options-label">申请项目与核对（可选）</summary><label for="review-project">正在核对的申请项目（仅本机）</label><select id="review-project"><option value="">普通浏览，不选择项目</option></select><p id="review-project-goal" class="note">选择已保存的申请项目，按完整目标核对招生机会与本人资格。</p><button id="review-project-confirm" type="button" hidden>使用此项目最新目标</button> <a id="review-project-edit" href="applications.html" hidden>编辑此项目目标 →</a><details id="review-project-history" hidden><summary>此项目的失效或旧目标核对记录</summary><div id="review-project-history-list" class="note"></div></details><p id="review-project-api" class="note">本机服务不可用时仍可浏览导师；创建与保存申请目标需启动本机服务。</p><p class="note"><a id="review-project-create" href="applications.html">创建申请目标 →</a> · 先填写学校、院系与申请条件，点击保存后才写入本机。</p></details>
<div id="project-context" class="evidence" hidden></div><p id="generic-context" class="note" hidden><a id="generic-discovery" href="discovery.html">重新打开通用找导师 →</a>（明确退出当前专业／项目范围）</p>
<div class="discovery-layout"><aside><form id="criteria-form" class="criteria"><h2>查找导师</h2><label>导师姓名<input id="intent-name" placeholder="姓名或姓名中的文字" autocomplete="off"></label><p class="note search-help">姓名与研究关键词同时生效；姓名不保存到私人条件。</p><label class="wide">研究关键词（逗号分隔，任一命中）<input id="intent-topics" placeholder="时空预测, graph neural network"></label><div class="actions"><button class="primary" id="apply-criteria">查看候选</button><button type="button" id="save-criteria" disabled>保存我的条件</button></div><p id="criteria-dirty" class="note" role="status" hidden>条件已修改，当前候选仍是上次结果。请点击“查看候选”应用。</p><details id="filter-options" open><summary id="filter-options-label">学校与更多筛选 · 不限学校</summary><fieldset class="school-picker"><legend>学校（可多选，空为不限）</legend><label for="school-search">搜索学校</label><input id="school-search" type="search" placeholder="输入学校名称或简称代码" autocomplete="off"><div class="school-picker-actions"><button id="select-visible-schools" type="button">全选学校</button><button id="clear-school-search" type="button" hidden>清除搜索</button></div><div class="school-selection"><span id="school-selected-count" role="status"></span><button id="clear-schools" type="button">清空学校</button></div><div id="school-chips" class="school-chips" aria-label="已选学校"></div><div id="school-options" class="school-options" role="group" aria-label="选择学校"></div><p id="school-search-status" class="note" role="status"></p><label for="intent-schools" hidden>允许院校（兼容状态）</label><select id="intent-schools" multiple hidden tabindex="-1"></select></fieldset><details id="advanced-criteria"><summary>更多条件 · 学位、学校与筛选规则</summary><label>相关院系方向<select id="intent-group"><option value="">全部</option><option value="computer">计算机</option><option value="software">软件</option><option value="ai">人工智能</option><option value="cyber">网络安全</option><option value="control">自动化与控制</option><option value="information">电子信息交叉</option><option value="other">其他相关院系</option></select></label><p class="note">仅按院系名称导航，不等于跨专业报考资格。该临时方向不保存在私人条件中。</p>
<div class="criteria-fields">
<label>入学年度<input id="intent-year" type="number" min="2000" max="2100" placeholder="未知可留空"></label>
<label>学位<select id="intent-degree"><option value="any">尚未确定</option><option value="master">硕士</option><option value="phd">博士</option></select></label>
<label>申请渠道<select id="intent-route"><option value="unknown">尚未确定</option><option value="recommend">推免</option><option value="exam">统考</option><option value="assessment">申请考核</option></select></label>

</div>
{% for key,label in [('research','研究关键词'),('qualification','对应学位导师资格'),('email','公开邮箱'),('opportunity','本年度招生机会'),('eligibility','我的申请资格')] %}<label class="mode-row">{{ label }}<select id="mode-{{ key }}"><option value="hard">必须</option><option value="soft">偏好</option><option value="off">不限制</option></select></label>{% endfor %}
<label class="check"><input id="keep-unknown" type="checkbox" checked>保留必须条件待核实的候选</label><p class="note">必须条件明确未命中时排除；偏好仅用于排序。不按引用数或职称估算录取概率。</p>
<p id="project-filter-hint" class="note" hidden></p>
</details></details><p id="private-hint" class="note">本地服务可保存私人条件；静态打开仍可筛选。</p></form>

</aside><section id="discovery-results" tabindex="-1"><section class="review-panel" id="review-panel" hidden><h2>我的核对记录</h2><p id="review-scope" class="review-scope"></p><p class="note">这是我的核对记录；项目记录仅适用于所选项目及完整目标快照。请核对官方原文，不能将往年或其他渠道的结果套用。超过30天需复核。</p><form id="review-form">
<label>导师本年度是否接收申请<select id="review-opportunity"><option value="unknown">尚未明确</option><option value="pass">原文明确可以申请</option><option value="fail">原文明确不接收</option></select></label>
<label>我的申请资格<select id="review-eligibility"><option value="unknown">尚未核对我的条件</option><option value="pass">已按原文核对，满足</option><option value="fail">已按原文核对，不满足</option></select></label>
<div id="generic-review-evidence"><label>官方来源 URL<input id="review-source" type="url" placeholder="https://..."></label><label>支持结论的原文 / 条件说明<textarea id="review-quote"></textarea></label>
</div><div id="project-review-evidence" hidden>{% for key,label in [('opportunity','招生机会'),('eligibility','本人资格')] %}<fieldset><legend>{{ label }}的独立证据</legend><label>依据类型<select id="{{ key }}-evidence-kind"><option value="official">官方原文</option><option value="reply">已登记收到的同项目导师回复</option></select></label><label>官方来源 URL<input id="{{ key }}-evidence-url" type="url" placeholder="https://学校官网/..."></label><label>已收到的回复<select id="{{ key }}-evidence-reply"></select></label><label>支持本项结论的原文<textarea id="{{ key }}-evidence-quote"></textarea></label><label>适用范围说明<textarea id="{{ key }}-evidence-scope" placeholder="说明原文如何适用于当前年度、渠道、专业和本项判断；本人资格需自行核对个人条件"></textarea></label></fieldset>{% endfor %}<p class="note">两项分别核对；草稿与私人备注不能作为已收到的回复。未登记监测的官方URL须自行回查。记录超过30天需复核；保存不会发送邮件。</p></div><label class="check"><input id="review-confirmed" type="checkbox" required>我已核对适用年度/渠道，确认上述记录与原文一致</label><div class="actions"><button class="primary" id="review-save" disabled>保存核验记录</button><button type="button" id="review-cancel">收起并返回候选</button></div></form></section><div id="compare-selection" class="context-actions" hidden><span id="compare-count"></span><a id="compare-open" href="compare.html">查看对比</a><span class="note">已选导师可随时查看；2–5 位并排对比</span></div><div class="results-bar"><strong id="discovery-count"></strong><div class="toolbar"><button id="discovery-backup" disabled>条件与核验备份</button><button id="discovery-restore" disabled>恢复备份</button><input id="discovery-file" type="file" accept=".json" hidden></div></div>
<p id="intent-overview" class="note"></p><details id="criteria-explanation"><summary id="criteria-explanation-label">筛选规则与说明</summary><p id="candidate-order" class="note"></p><p id="intent-summary" class="note"></p></details><div id="candidate-list"></div><div class="actions"><button id="more-candidates" hidden>再显示20位</button><a href="index.html">查看全量表 →</a></div></section></div>
<p class="note">地区/校区、经费、指导风格及详细报名条件尚未统一核验，暂不作为自动过滤字段。可在联系时明确询问；导师资格不等于当前名额。</p>
</main><script src="discovery-data.js?v=20261115-6"></script><script src="discovery-core.js?v=20261115-6"></script><script src="discovery.js?v=20261115-6"></script><script src="browser-library-core.js?v=20261115-6"></script><script src="browser-library.js?v=20261115-6"></script></body></html>
