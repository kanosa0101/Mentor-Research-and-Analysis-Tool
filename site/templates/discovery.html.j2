{% set current_page = 'discovery' %}
<!DOCTYPE html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>找导师 · 导师库</title><style>
.page-discovery main{max-width:1240px;margin:auto;padding:28px 24px}.intro{margin:8px 0 24px}.discovery-layout{display:grid;grid-template-columns:264px minmax(0,1fr);gap:24px;align-items:start}.criteria{padding:20px;background:var(--card);border:1px solid var(--line);border-radius:10px;min-width:0}.criteria h2{font-size:17px;margin:0 0 12px}.criteria label{display:block;font-size:13px;margin:12px 0 6px}.criteria input:not([type=checkbox]),.criteria select{width:100%;min-width:0;padding:9px 10px}.criteria .check,.criteria .school-option{display:flex;align-items:center;gap:8px;line-height:1.6}.criteria input[type=checkbox]{width:16px;height:16px;flex-shrink:0}.criteria fieldset{border:0;padding:0;margin:12px 0;min-width:0}.criteria legend{font-size:13px;margin-bottom:4px}.qualification-options{display:flex;gap:14px}.qualification-options .check{margin:4px 0}.criteria details{border-top:1px solid var(--line);padding-top:12px;margin-top:16px}.criteria summary{font-size:13px;font-weight:600;cursor:pointer;color:var(--accent)}.school-options{max-height:200px;overflow:auto;border:1px solid var(--line);border-radius:8px;padding:4px}.criteria .school-option{margin:0;padding:8px 6px;min-height:40px}.school-option[hidden]{display:none!important}.school-selection,.school-picker-actions{display:flex;justify-content:space-between;gap:8px;margin:10px 0;font-size:13px}.school-picker-actions button,.school-selection button,.school-chips button{font-size:13px;padding:5px 8px}.school-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.school-chips:empty{display:none}.school-chips button{overflow-wrap:anywhere;text-align:left}.criteria-submit{width:100%;margin-top:16px}.note{font-size:13px;line-height:1.65;color:var(--muted)}.search-help{margin:6px 0 12px}.criteria #title-options{display:grid;grid-template-columns:1fr 1fr;gap:0 8px}.criteria #title-options label{margin:5px 0}#criteria-dirty{background:var(--soft);padding:8px}#discovery-message{margin-bottom:16px;line-height:1.6}#discovery-message:empty,#school-search-status:empty{display:none}.error{color:#a32d25}#application-context{font-size:13px;margin:12px 0}#discovery-results{min-width:0;container-type:inline-size;scroll-margin-top:112px}.results-bar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:0 0 8px}.results-bar strong{font-size:17px}#intent-overview{margin:0 0 8px;overflow-wrap:anywhere}.candidate-order{margin:0 0 18px}#candidate-list{display:grid;grid-template-columns:minmax(0,1fr);gap:16px;align-items:stretch}.page-discovery .results-card{box-sizing:border-box;min-width:0;height:410px;padding:20px;margin:0;background:var(--card);border:1px solid var(--line);border-radius:10px;display:grid;grid-template-rows:94px 76px 45px 43px 40px 30px;row-gap:4px;overflow:hidden}.candidate-header{min-width:0}.candidate-heading{display:flex;align-items:start;justify-content:space-between;gap:10px}.page-discovery .results-card h2{font-size:17px;line-height:24px;margin:0;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.candidate-heading a{text-decoration:none}.candidate-qualification{font-size:12px;line-height:20px;white-space:nowrap;background:var(--soft);padding:2px 6px;border-radius:5px;flex-shrink:0}.candidate-unit{font-size:13px;line-height:20px;height:40px;margin:5px 0 0;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.candidate-title{font-size:13px;line-height:20px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.research-preview{font-size:14px;line-height:24px;margin:0;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;overflow-wrap:anywhere}.research-preview>span{color:var(--muted);font-size:13px}.public-email{display:flex;flex-direction:column;font-size:13px;line-height:21px;min-width:0}.public-email>span:first-child{color:var(--muted)}.public-email a{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.candidate-source{display:flex;flex-direction:column;font-size:12px;line-height:20px;min-width:0}.candidate-source>*{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.candidate-source>span{color:var(--muted)}.card-primary-actions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;align-items:stretch}.page-discovery .card-primary-actions>*{font-size:13px;line-height:20px;padding:9px 2px;min-width:0;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:7px;white-space:nowrap}.card-primary-actions .primary{background:var(--accent);color:#fff;border-color:var(--accent)}.candidate-bookmark{display:flex;align-items:end}.page-discovery .candidate-bookmark button{border:0;background:transparent;padding:0;min-height:24px;font-size:12px;color:var(--muted)}.empty{grid-column:1/-1;background:var(--card);border:1px dashed var(--line);padding:24px;border-radius:10px}.empty h2{font-size:17px}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin:20px 0}.directory-footer{font-size:13px;margin-top:28px}.directory-footer summary{cursor:pointer;color:var(--muted)}
@container(min-width:760px){ #candidate-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:850px){.page-discovery main{padding:20px 16px}.discovery-layout{grid-template-columns:1fr;gap:20px}.criteria{padding:16px}.primary-search-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.primary-search-fields label{margin-top:0}.criteria-disclosures{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start}.criteria-disclosures details[open],.criteria-disclosures .school-chips{grid-column:1/-1}.criteria-disclosures .school-chips{order:2}.criteria details{margin-top:8px}.intro{margin-bottom:18px}.page-discovery .results-card{height:410px;padding:16px;grid-template-rows:94px 76px 45px 43px 40px 38px}.qualification-options{gap:20px}#discovery-results{scroll-margin-top:112px}}
@media(max-width:360px){.candidate-qualification{font-size:11px}.page-discovery .card-primary-actions>*{font-size:12px}.card-primary-actions{gap:5px}.criteria #title-options{grid-template-columns:1fr}}

body.page-discovery .results-card{height:384px;grid-template-rows:104px 72px 42px 36px 40px 24px;padding:20px}
body.page-discovery .candidate-heading h2{height:44px;line-height:22px;white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
body.page-discovery .candidate-unit{height:36px;line-height:18px;margin-top:4px}
body.page-discovery .candidate-title{line-height:18px}
body.page-discovery .candidate-source{line-height:18px}
body.page-discovery .results-card .card-primary-actions{display:grid;grid-template-columns:1fr 1fr 1fr;align-items:stretch;gap:8px;flex-wrap:nowrap}
body.page-discovery .results-card .card-primary-actions>*{min-height:40px;padding:8px 2px;font-size:13px;line-height:22px}
@media(max-width:850px){body.page-discovery .results-card{padding:16px;grid-template-rows:104px 72px 42px 36px 44px 24px}body.page-discovery .results-card .card-primary-actions>*{min-height:44px;padding:10px 2px}}
@media(max-width:360px){body.page-discovery .results-card .card-primary-actions{gap:5px}body.page-discovery .results-card .card-primary-actions>*{font-size:12px}}
</style>{% if discovery_css is defined %}<style>{{ discovery_css|safe }}</style>{% else %}{% include '_ui_head.html.j2' %}{% endif %}</head><body class="page page-discovery">{% include '_nav.html.j2' %}<main>
<h1>找导师</h1><p class="intro muted">按研究兴趣和学校找人，核对资料，再准备联系。</p><div id="discovery-message" role="status" aria-live="polite"></div><p id="unit-context" class="note" hidden></p><button id="clear-unit-context" type="button" hidden>清除院系范围</button><p id="application-context" hidden>申请目标仍保留在<a id="application-context-link" href="applications.html">我的申请</a>；本页按导师自身资料筛选。</p>
<div class="discovery-layout"><aside><form id="criteria-form" class="criteria"><h2>筛选导师</h2><div class="primary-search-fields"><label>导师姓名<input id="intent-name" autocomplete="off" placeholder="可留空"></label><label>研究关键词<input id="intent-topics" autocomplete="off" placeholder="如：计算机视觉"></label></div><p class="note search-help">多个关键词用逗号分隔，任一命中即可。</p><fieldset><legend>导师招生资格 · 可多选</legend><div id="qualification-options" class="qualification-options"><label class="check"><input type="checkbox" value="phd">博导</label><label class="check"><input type="checkbox" value="master">硕导</label></div></fieldset>
<div class="criteria-disclosures"><details id="filter-options"><summary id="filter-options-label" tabindex="0">学校 · 不限</summary><label for="school-search">搜索学校</label><input id="school-search" type="search" autocomplete="off" placeholder="学校名称或简称代码"><div class="school-picker-actions"><button id="select-visible-schools" type="button">选中搜索结果</button></div><div class="school-selection"><span id="school-selected-count"></span><button id="clear-schools" type="button">清空学校</button></div><div id="school-options" class="school-options" role="group" aria-label="学校多选"></div><p id="school-search-status" class="note" role="status"></p></details><div id="school-chips" class="school-chips" aria-label="已选学校"></div><details id="advanced-criteria"><summary id="advanced-criteria-label">更多筛选</summary><fieldset><legend>职称 · 可多选</legend><div id="title-options"></div></fieldset><label>相关院系<select id="intent-group"><option value="">不限</option><option value="computer">计算机</option><option value="software">软件</option><option value="ai">人工智能</option><option value="cyber">网络安全</option><option value="control">自动化与控制</option><option value="information">电子信息交叉</option><option value="other">其他相关院系</option></select></label><label class="check"><input id="include-missing-email" type="checkbox">包含缺邮箱资料</label><p class="note">默认只显示有格式有效、来源可追溯的公开邮箱记录，不保证邮件送达。</p></details></div><button class="primary criteria-submit" id="apply-criteria">查看候选</button><p id="criteria-dirty" class="note" role="status" hidden>条件已修改，请点击“查看候选”。</p></form></aside>
<section id="discovery-results" tabindex="-1"><div id="compare-selection" class="context-actions" hidden><span id="compare-count"></span><a id="compare-open" href="compare.html">查看对比</a><span class="note">最多 5 位</span></div><div class="results-bar"><strong id="discovery-count"></strong></div><p id="intent-overview" class="note"></p><p class="candidate-order note">资料较完整的优先，同组顺序在本次浏览中保持稳定。</p><div id="candidate-list"></div><div class="actions"><button id="more-candidates" hidden>再显示20位</button><a href="index.html">查看完整目录 →</a></div></section></div>
<div class="directory-footer"><p><a href="local.html">到本机准备材料与记录沟通 →</a></p><details><summary>来源说明与历史记录</summary><p class="note">导师资格不代表当前名额。完整研究内容、来源日期和招募条件请查看导师资料。院系分类不表示本科专业准入。旧筛选与核对记录继续保留，但不参与本页过滤或排序。</p><button id="legacy-backup" type="button">导出旧筛选与核对记录（本机）</button></details></div>
</main>{% if discovery_js is defined %}<script>{{ discovery_js|safe }}</script>{% else %}<script defer src="discovery-entry.js?v=directory-v2"></script><script defer src="browser-library-core.js?v=20261115-7"></script><script defer src="browser-library.js?v=20261115-7"></script>{% endif %}</body></html>
