{% set current_page = 'discovery' %}
<!DOCTYPE html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>条件找导师 · 导师库</title>
<style>
main{margin:auto;padding:28px 24px}.intro{line-height:1.7;max-width:760px;margin:8px 0 24px}.discovery-layout{display:grid;grid-template-columns:264px minmax(0,1fr);gap:24px;align-items:start}.criteria,.results-card,.review-panel{background:var(--card,#fff);border:1px solid var(--line);border-radius:10px;padding:20px;min-width:0}.criteria h2{font-size:17px;margin:0 0 16px}.criteria label,.review-panel label{display:block;font-size:13px;margin:12px 0 6px;line-height:1.6}.criteria input:not([type=checkbox]),.criteria select,.review-panel input:not([type=checkbox]),.review-panel select,.review-panel textarea{padding:9px 10px;width:100%;min-width:0;border:1px solid var(--line)}.criteria-fields{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}.criteria .check,.review-panel .check{display:flex;gap:8px;align-items:flex-start;line-height:1.6}.mode-row{display:flex!important;align-items:center;justify-content:space-between;gap:12px;margin:12px 0!important}.criteria .mode-row select{width:104px;flex-shrink:0}.actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:16px 0 0}.note,.badge{font-size:13px;line-height:1.65;color:var(--muted)}.error{color:#a32d25}.search-help{margin:6px 0 12px}.criteria .criteria-submit{width:100%;margin-top:16px}.criteria #filter-options,.criteria #advanced-criteria{border-top:1px solid var(--line);padding-top:12px;margin-top:16px}.criteria summary,.review-panel summary,.private-tools summary{cursor:pointer;color:var(--accent);line-height:1.6;font-size:13px}.criteria summary{font-weight:600}.school-picker{border:0;padding:0;margin:12px 0 0;min-width:0}.school-picker>legend{position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden}.school-selection{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:10px 0;font-size:13px}.school-selection button,.school-picker-actions button{padding:6px 8px;font-size:13px}.school-picker-actions{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.school-chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.school-chips:empty{display:none}.school-chips button{font-size:13px;text-align:left;padding:5px 8px;background:var(--soft);overflow-wrap:anywhere}.school-options{max-height:200px;overflow-y:auto;border:1px solid var(--line);border-radius:8px;padding:4px}.criteria .school-option{display:flex;align-items:center;gap:8px;min-height:40px;padding:6px;margin:0;cursor:pointer}.school-option input{flex-shrink:0;width:16px;height:16px}.school-option:hover,.school-option:focus-within{background:var(--soft)}.school-option span{overflow-wrap:anywhere}.school-option[hidden]{display:none!important}#school-search-status:empty,#discovery-message:empty{display:none}#criteria-dirty{background:#fbf4e8;padding:10px;border-radius:8px}#discovery-message{line-height:1.65;white-space:pre-wrap;margin-bottom:16px}.results-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:8px;flex-wrap:wrap}.results-bar strong{font-size:17px}#intent-overview{margin:0 0 8px}#criteria-explanation{font-size:13px;line-height:1.6;color:var(--muted);margin:0 0 20px}#criteria-explanation summary{cursor:pointer}#candidate-order{margin-top:10px}#discovery-results{container-type:inline-size;scroll-margin-top:116px;min-width:0}#candidate-list{display:grid;grid-template-columns:minmax(0,1fr);gap:16px;align-items:start}.results-card{margin:0;overflow-wrap:anywhere;align-self:start}.results-card h2{font-size:20px;line-height:1.4;margin:0 0 7px}.results-card h2 a{text-decoration:none}.candidate-heading{display:flex;justify-content:space-between;align-items:start;gap:12px}.candidate-heading>div{min-width:0}.candidate-qualification{font-size:12px;padding:4px 7px;border-radius:6px;white-space:nowrap;background:var(--soft);color:var(--accent)}.results-card .badge{margin:0}.candidate-title{display:inline-block;margin-top:4px}.research-preview{line-height:1.7;margin:14px 0 10px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.research-preview strong{font-size:13px;color:var(--muted);font-weight:500}.research-missing{font-size:13px;color:var(--muted)}.public-email{font-size:13px;line-height:1.6;margin:10px 0;overflow-wrap:anywhere}.public-email a{text-decoration:none}.card-primary-actions{gap:8px;margin:16px 0 0}.card-primary-actions>*{font-size:13px}.card-primary-actions a{padding:8px 10px;border-radius:7px;text-decoration:none;border:1px solid var(--line)}.card-primary-actions .primary{background:var(--accent);color:white;border-color:var(--accent);font-weight:600}.card-primary-actions button{padding:8px 10px}.candidate-disclosures{display:flex;gap:8px 20px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:16px;padding-top:12px}.candidate-disclosures details{min-width:0;max-width:100%}.candidate-disclosures details[open]{flex-basis:100%}.candidate-disclosures summary{font-size:13px;color:var(--muted);cursor:pointer;line-height:1.6}.candidate-disclosures details[open]>summary{color:var(--accent)}.checks{list-style:none;padding:0;margin:12px 0}.checks li{padding:10px 0;border-bottom:1px solid var(--line);font-size:13px;line-height:1.7}.checks li:last-child{border-bottom:0}.evidence{border-left:3px solid var(--line);padding:8px 12px;font-size:13px;line-height:1.7;white-space:pre-wrap;margin:12px 0}.preview-source{margin:10px 0}.empty{grid-column:1/-1;padding:24px;background:white;border:1px dashed var(--line);border-radius:10px;line-height:1.7}.review-panel{margin:0 0 20px;overflow-wrap:anywhere;scroll-margin-top:115px}.review-panel textarea{min-height:100px}.review-panel h2{margin-top:0}.review-panel fieldset{min-width:0;border:1px solid var(--line);margin:16px 0;padding:12px}.review-panel legend{font-weight:600;font-size:13px}#review-project{width:100%;min-width:0;padding:9px}#review-project-goal{overflow-wrap:anywhere}#project-review-evidence{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}#project-review-evidence>p{grid-column:1/-1}#project-review-evidence fieldset{margin:4px 0}#project-options{padding:14px 16px;margin:16px 0 0}.private-tools{font-size:13px;margin:14px 0;padding:0 4px}.private-tools .toolbar{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.private-tools button{font-size:13px}.page-limit-note{margin-top:24px}.page-limit-note summary{font-size:13px;color:var(--muted);cursor:pointer}
.results-card .browser-library-action{margin-top:10px}.results-card .browser-library-action button{background:transparent;border:0;padding:0;min-height:28px;font-size:13px}.results-card .browser-library-action span{font-size:13px}
.page-discovery .results-card .badge{padding:0;background:transparent}.workflow-tools{margin:14px 0}.workflow-tools>summary{font-size:13px;color:var(--muted);cursor:pointer}.workflow-tools .private-tools{margin-top:14px}.workflow-tools #project-options{margin-top:8px}
@container(min-width:760px){ #candidate-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:850px){main{padding:20px 16px}.discovery-layout{grid-template-columns:1fr;gap:20px}.intro{margin-bottom:18px}.criteria{padding:16px}.criteria h2{margin-bottom:12px}.criteria .primary-search-fields{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}.criteria .primary-search-fields label{margin-top:0}.criteria .criteria-fields{grid-template-columns:1fr 1fr}.criteria-disclosures{display:grid;grid-template-columns:1fr 1fr;gap:0 12px;align-items:start}.criteria-disclosures>details[open],.criteria-disclosures>.school-chips{grid-column:1/-1}.criteria-disclosures>.school-chips{order:2}.results-card{padding:16px}#project-options{padding:12px 16px}.private-tools{margin:12px 0 0}#project-review-evidence{grid-template-columns:1fr}.card-primary-actions{gap:8px}.candidate-heading{gap:8px}#discovery-results{scroll-margin-top:120px}}
</style>{% if discovery_css is defined %}<style>{{ discovery_css|safe }}</style>{% else %}{% include '_ui_head.html.j2' %}{% endif %}</head><body class="page page-discovery">{% include '_nav.html.j2' %}<main>
<h1>找导师</h1><p class="intro muted">按研究兴趣和学校缩小范围，了解导师，再决定联系谁。</p>
<div id="discovery-message" role="status" aria-live="polite"></div>
<p id="unit-context" class="note" hidden></p><button id="clear-unit-context" type="button" hidden>清除院系范围</button>

<div id="project-context" class="evidence" hidden></div><p id="generic-context" class="note" hidden><a id="generic-discovery" href="discovery.html">重新打开通用找导师 →</a>（明确退出当前专业／项目范围）</p>
<div class="discovery-layout"><aside><form id="criteria-form" class="criteria"><h2>筛选导师</h2>
<div class="primary-search-fields"><label>导师姓名<input id="intent-name" placeholder="可留空" autocomplete="off"></label><label>研究关键词<input id="intent-topics" placeholder="如：计算机视觉" autocomplete="off"></label></div><p class="note search-help">多个关键词用逗号分隔，任一命中即可。</p>
<div class="criteria-fields"><label>目标学位<select id="intent-degree"><option value="any">不限</option><option value="master">硕士</option><option value="phd">博士</option></select></label><label>相关院系<select id="intent-group"><option value="">不限</option><option value="computer">计算机</option><option value="software">软件</option><option value="ai">人工智能</option><option value="cyber">网络安全</option><option value="control">自动化与控制</option><option value="information">电子信息交叉</option><option value="other">其他相关院系</option></select></label></div><p id="degree-filter-note" class="note" hidden></p>
<div class="criteria-disclosures"><details id="filter-options" open><summary id="filter-options-label">学校 · 不限</summary><fieldset class="school-picker"><legend>学校（可多选）</legend><label for="school-search">搜索并选择学校</label><input id="school-search" type="search" placeholder="学校名称或简称代码" autocomplete="off"><div class="school-picker-actions"><button id="select-visible-schools" type="button">全选学校</button><button id="clear-school-search" type="button" hidden>清除搜索</button></div><div class="school-selection"><span id="school-selected-count" role="status"></span><button id="clear-schools" type="button">清空学校</button></div><div id="school-options" class="school-options" role="group" aria-label="选择学校"></div><p id="school-search-status" class="note" role="status"></p><label for="intent-schools" hidden>允许院校（兼容状态）</label><select id="intent-schools" multiple hidden tabindex="-1"></select></fieldset></details><div id="school-chips" class="school-chips" aria-label="已选学校"></div>
<details id="advanced-criteria"><summary id="advanced-criteria-label">更多筛选设置</summary><p class="note">目标学位默认优先展示有对应导师资格的记录；资格不代表当前有招生名额。</p><div class="criteria-fields"><label>入学年度<input id="intent-year" type="number" min="2000" max="2100" placeholder="可留空"></label><label>申请渠道<select id="intent-route"><option value="unknown">未确定</option><option value="recommend">推免</option><option value="exam">统考</option><option value="assessment">申请考核</option></select></label></div>
{% for key,label in [('research','研究关键词'),('qualification','对应学位导师资格'),('email','公开邮箱'),('opportunity','已核对的招生机会'),('eligibility','已核对的本人资格')] %}<label class="mode-row">{{ label }}<select id="mode-{{ key }}"><option value="hard">必须符合</option><option value="soft">优先展示</option><option value="off">不限</option></select></label>{% endfor %}
<label class="check"><input id="keep-unknown" type="checkbox" checked>同时保留信息尚未明确的导师</label><p class="note">“必须符合”会排除明确不符合的记录；信息未知是否保留由上方选项决定。招生机会和本人资格来自你的核对记录，不由导师职称推断。</p><p id="project-filter-hint" class="note" hidden></p></details></div>
<button class="primary criteria-submit" id="apply-criteria">查看候选</button><p id="criteria-dirty" class="note" role="status" hidden>条件已修改，请点击“查看候选”更新结果。</p></form>
<details id="workflow-tools" class="workflow-tools"><summary>申请项目与本机工具</summary><details id="project-options" class="review-panel"><summary id="project-options-label">申请项目与核对（可选）</summary><label for="review-project">正在核对的申请项目（仅本机）</label><select id="review-project"><option value="">普通浏览，不选择项目</option></select><p id="review-project-goal" class="note">选择已保存的申请项目，按完整目标核对招生机会与本人资格。</p><button id="review-project-confirm" type="button" hidden>使用此项目最新目标</button> <a id="review-project-edit" href="applications.html" hidden>编辑此项目目标 →</a><details id="review-project-history" hidden><summary>此项目的失效或旧目标核对记录</summary><div id="review-project-history-list" class="note"></div></details><p id="review-project-api" class="note">本机服务不可用时仍可浏览导师；创建与保存申请目标需启动本机服务。</p><p class="note"><a id="review-project-create" href="applications.html">创建申请目标 →</a> · 先填写学校、院系与申请条件，点击保存后才写入本机。</p></details>
<details class="private-tools"><summary>保存与备份（本机）</summary><p id="private-hint" class="note">本机版可保存条件和核对记录；公开站仍可查找导师。</p><div class="toolbar"><button type="button" id="save-criteria" disabled>保存我的条件</button><button id="discovery-backup" disabled>导出备份</button><button id="discovery-restore" disabled>恢复备份</button><input id="discovery-file" type="file" accept=".json" hidden></div></details></details>
</aside><section id="discovery-results" tabindex="-1"><section class="review-panel" id="review-panel" hidden><h2>我的核对记录</h2><p id="review-scope" class="review-scope"></p><p class="note">这是我的核对记录；项目记录仅适用于所选项目及完整目标快照。请核对官方原文，不能将往年或其他渠道的结果套用。超过30天需复核。</p><form id="review-form">
<label>导师本年度是否接收申请<select id="review-opportunity"><option value="unknown">尚未明确</option><option value="pass">原文明确可以申请</option><option value="fail">原文明确不接收</option></select></label>
<label>我的申请资格<select id="review-eligibility"><option value="unknown">尚未核对我的条件</option><option value="pass">已按原文核对，满足</option><option value="fail">已按原文核对，不满足</option></select></label>
<div id="generic-review-evidence"><label>官方来源 URL<input id="review-source" type="url" placeholder="https://..."></label><label>支持结论的原文 / 条件说明<textarea id="review-quote"></textarea></label>
</div><div id="project-review-evidence" hidden>{% for key,label in [('opportunity','招生机会'),('eligibility','本人资格')] %}<fieldset><legend>{{ label }}的独立证据</legend><label>依据类型<select id="{{ key }}-evidence-kind"><option value="official">官方原文</option><option value="reply">已登记收到的同项目导师回复</option></select></label><label>官方来源 URL<input id="{{ key }}-evidence-url" type="url" placeholder="https://学校官网/..."></label><label>已收到的回复<select id="{{ key }}-evidence-reply"></select></label><label>支持本项结论的原文<textarea id="{{ key }}-evidence-quote"></textarea></label><label>适用范围说明<textarea id="{{ key }}-evidence-scope" placeholder="说明原文如何适用于当前年度、渠道、专业和本项判断；本人资格需自行核对个人条件"></textarea></label></fieldset>{% endfor %}<p class="note">两项分别核对；草稿与私人备注不能作为已收到的回复。未登记监测的官方URL须自行回查。记录超过30天需复核；保存不会发送邮件。</p></div><label class="check"><input id="review-confirmed" type="checkbox" required>我已核对适用年度/渠道，确认上述记录与原文一致</label><div class="actions"><button class="primary" id="review-save" disabled>保存核验记录</button><button type="button" id="review-cancel">收起并返回候选</button></div></form></section><div id="compare-selection" class="context-actions" hidden><span id="compare-count"></span><a id="compare-open" href="compare.html">查看对比</a><span class="note">已选导师可随时查看；2–5 位并排对比</span></div><div class="results-bar"><strong id="discovery-count"></strong></div>
<p id="intent-overview" class="note"></p><details id="criteria-explanation"><summary id="criteria-explanation-label">筛选规则与说明</summary><p id="candidate-order" class="note"></p><p id="intent-summary" class="note"></p></details><div id="candidate-list"></div><div class="actions"><button id="more-candidates" hidden>再显示20位</button><a href="index.html">查看全量表 →</a></div></section></div>
<p id="public-workspace-link" class="note"><a href="local.html">需要管理材料与沟通？使用本机申请工作台 →</a></p><details class="page-limit-note"><summary>哪些信息还需要联系导师确认？</summary><p class="note">地区/校区、经费、指导方式和具体招生名额未统一核验，建议结合官网与导师回复确认。导师资格不等于当前名额。</p></details>
</main>{% if discovery_js is defined %}<script>{{ discovery_js|safe }}</script>{% else %}<script defer src="discovery-entry.js?v=20261115-7b"></script><script defer src="browser-library-core.js?v=20261115-7"></script><script defer src="browser-library.js?v=20261115-7"></script>{% endif %}</body></html>
