{% set current_page = 'notices' %}
<!DOCTYPE html>
<html lang="zh">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>官方招生通知 · 导师库</title>
<style>
body{margin:0;background:#f6f7f9;color:#171e2b;font:14px -apple-system,"Segoe UI","Microsoft YaHei",sans-serif}
main{max-width:1100px;margin:24px auto;padding:0 20px}a{color:#2f54c8}h1{font-size:21px}
.hint{padding:12px;background:#fff7e8;border:1px solid #f2ddb0;border-radius:8px;line-height:1.7}
.bar{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0}select,input{padding:8px;border:1px solid #e6e9ef;border-radius:6px}
.card{background:white;border:1px solid #e6e9ef;border-radius:8px;padding:14px;margin:10px 0}.meta{color:#6b7280;font-size:12px;line-height:1.8}.title{font-size:15px;font-weight:600}.error{color:#b45309}
.intro{line-height:1.8;max-width:760px}.bar label{display:grid;gap:7px;flex:1 1 220px}.bar select,.bar input{width:100%;max-width:100%;box-sizing:border-box}.notice-sources{margin:18px 0;line-height:1.8}.notice-sources summary{cursor:pointer;color:var(--accent)}#notice-context{line-height:1.8}#current-source,#empty-source{line-height:1.8;overflow-wrap:anywhere}.card{padding:18px}.card .title{line-height:1.7}.card .meta{margin-top:6px}.bar{max-width:780px}.hint button{min-height:44px}@media(max-width:600px){.bar{gap:14px}.bar label{flex-basis:100%}main{padding:0 16px}.card{padding:16px}}
#notice-more-years{line-height:1.8;margin:12px 0}#notice-more-years summary{cursor:pointer}.notice-cycle-filters{max-width:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.notice-years{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.notice-years div{min-width:0}.notice-years dt{font-size:12px;color:var(--muted)}.notice-years dd{margin:6px 0;font-weight:600}.notice-cycle-label{color:var(--accent);font-weight:600}.notice-evidence{line-height:1.8;margin:12px 0}.notice-evidence summary{cursor:pointer}.notice-buckets{display:flex;gap:10px;flex-wrap:wrap}.notice-buckets button{min-height:40px}.notice-track{line-height:1.7}@media(max-width:600px){.notice-cycle-filters{grid-template-columns:1fr 1fr}.notice-cycle-filters label:first-child{grid-column:1/-1}.notice-years{grid-template-columns:1fr}.notice-years div{display:flex;justify-content:space-between;gap:12px}.notice-years dd{margin:0}.notice-evidence ul{padding-left:20px}}
</style>{% include '_ui_head.html.j2' %}</head>
<body>{% include '_nav.html.j2' %}<main>
<h1>官方招生通知</h1>
<p class="intro">先选自己的毕业届别和申请渠道。入学年、毕业届别和活动年分别显示；当前周期不等于正在报名，条件与截止时间仍需查官方原文。</p>
<div class="bar"><label>学校与院系<select id="school"><option value="">全部院系</option>{% for key, source in sources.items() %}<option value="{{ key }}">{{ key }}</option>{% endfor %}</select></label><label>搜索标题<input id="search" placeholder="关键词或年份"></label></div>
<div class="bar notice-cycle-filters"><label>查看范围<select id="notice-cycle"><option value="current">当前周期与下一届准备</option><option value="historical">往届 / 已结束阶段</option><option value="unknown">届别或周期待核验</option><option value="all">全部通知</option></select></label><label>申请渠道<select id="notice-route"><option value="">全部渠道</option><option value="recommend">推免</option><option value="exam">全国统考</option><option value="assessment">申请考核</option><option value="winter_camp">冬令营</option><option value="summer_camp">夏令营</option><option value="research">科研实践</option><option value="unknown">通用政策 / 渠道未拆分</option></select></label><label>研究生入学年份<select id="notice-admission-year"><option value="">全部入学年份</option><option value="unknown">待核验</option></select></label></div>
<details id="notice-more-years"><summary>更多年份条件：本科毕业届别、活动年</summary><div class="bar"><label>本科毕业届别<select id="notice-graduation-year"><option value="">全部毕业届别</option><option value="unknown">待核验</option></select></label><label>活动年份<select id="notice-activity-year"><option value="">全部活动年份</option><option value="unknown">待核验 / 不适用</option></select></label></div></details>
<p class="hint" id="notice-cycle-guide"></p><p id="notice-buckets" class="notice-buckets"></p>
<p id="notice-context" class="muted" role="status"></p><p><a id="notice-policy-link" href="admissions.html">核对学校与院系要求 →</a></p>
<p id="notice-general-hint" class="hint" hidden>当前按单个渠道筛选。学校通用招生章程可能包含同年资格、专业及材料要求，尚未拆分到这个渠道。<button id="notice-general-policy" type="button">查看同年通用政策</button></p>
<div id="current-source"></div><p id="count" role="status" aria-live="polite"></p>
<div id="notice-empty" class="hint" hidden><p>当前筛选没有通知。可切换“届别或周期待核验”或“往届 / 已结束阶段”查找参考；未收录不代表没有招生安排。</p><button id="clear-search" type="button">清除标题搜索</button><p id="empty-source"></p></div>
<details class="notice-sources"><summary>通知范围与来源检查</summary><p class="meta">已接入 {{ sources|length }} 个院系当前栏目；不保证覆盖全部招生通知。标题语义分类与正文核验分开；不按公告发布年份、抓取日期或栏目仍可见推断届别。年份和日期未核验时明确标注。</p>
{% for key, source in sources.items() %}<div class="meta{% if source.error %} error{% endif %}" data-source="{{ key }}"><a href="{{ source.url }}" target="_blank" rel="noopener">{{ key }} 官方栏目</a> · 最后抓取 {{ source.fetched_at or "未知" }}{% if source.error %} · 抓取失败：{{ source.error }}{% endif %}</div>{% endfor %}</details>
{% for key, source in sources.items() %}{% if source.error %}<p class="hint" data-source-error="{{ key }}"><span>{{ key }}</span> 来源抓取失败，保留历史通知；请到官网核实最新安排。</p>{% endif %}{% endfor %}
{% for n in notices %}
{% set c = n.classification|default({}) %}
<article class="card" data-notice-id="{{ n.id }}" data-school="{{ n.school }}/{{ n.dept }}" data-title="{{ n.title }}">
<a class="title" href="{{ n.url }}" target="_blank" rel="noopener">{{ n.title }}</a>
<div class="meta">{{ n.unit }} · 发布日期 {{ n.publication_date or "官网列表未明确提供完整日期" }} · 抓取 {{ n.fetched_at }}</div>
<p class="notice-cycle-label">{{ c.cycle_label|default("届别或周期待核验") }}</p>
{% set is_activity = 'winter_camp' in c.routes|default([]) or 'summer_camp' in c.routes|default([]) or 'research' in c.routes|default([]) %}
<dl class="notice-years">{% if c.admission_year %}<div><dt>研究生入学年</dt><dd>{{ c.admission_year }} 入学</dd></div>{% elif not is_activity %}<div><dt>研究生入学年</dt><dd>待核验</dd></div>{% endif %}{% if c.graduation_year %}<div><dt>面向本科毕业届别</dt><dd>{{ c.graduation_year }} 届</dd></div>{% elif is_activity %}<div><dt>面向本科毕业届别</dt><dd>待核验</dd></div>{% endif %}{% if is_activity %}<div><dt>活动年份</dt><dd>{{ c.activity_year or "待核验" }}</dd></div>{% endif %}</dl>
{% for track in c.tracks|default([]) %}<p class="notice-track"><strong>{{ track.route_label }} · {{ track.stage_label }}</strong>{% if c.tracks|length > 1 %} · {{ track.cycle_label }}{% endif %}<br><span class="meta">{{ track.note }}</span></p>{% endfor %}
{% if n.deadline %}<p class="meta">报名截止 {{ n.deadline }}</p>{% endif %}
<details class="notice-evidence"><summary>为什么这样分类 · 依据与待核验事项</summary><p class="meta">分类日期 {{ c.as_of|default("待核验") }}。标题语义仅用于整理通知，不等于正文已核验。</p><ul>{% for reason in c.basis|default([]) %}<li>{{ reason }}</li>{% endfor %}</ul><p class="meta">标题出现的年份 {{ n.title_years|join("、") or "未明确" }}，不会直接当作毕业届别。</p></details>
<div class="meta">{% if n.reviewed %}已核验{% else %}候选通知，申请条件和日期尚未核验{% endif %}{% if not n.seen_in_latest_list %} · 最近栏目页未出现，保留历史记录{% endif %} · <a href="{{ n.source }}" target="_blank">列表来源</a></div>
{% if c.linked_opportunity_id %}<p><a href="opportunities.html?id={{ c.linked_opportunity_id|urlencode }}">查看已整理的条件与材料 →</a></p>{% endif %}
</article>
{% endfor %}
<script id="notice-data" type="application/json">{{ notices|tojson }}</script>
<script src="admissions-data.js?v=20261115-4"></script><script src="notices-core.js?v=20261115-4"></script><script src="notices.js?v=20261115-4"></script></main><script src="browser-library-core.js?v=20261115-5"></script><script src="browser-library.js?v=20261115-5"></script></body></html>
