{% set prefix = '../' if current_page == 'detail' else '' %}
<header class="top site-header"><div class="site-header-inner">
<a class="site-brand" href="{{ prefix }}start.html">◈ 导师库 · 申请助手</a>
<nav aria-label="主导航">
{% for key,label,file in [('start','申请导航','start.html'),('discovery','找导师','discovery.html'),('opportunities','院校活动','opportunities.html'),('admissions','学校要求','admissions.html'),('applications','我的申请','applications.html')] %}
<a href="{{ prefix }}{{ file }}" {% if current_page == key %}aria-current="page"{% endif %}{% if key == 'applications' and current_page == 'desk' %} id="manage-link"{% endif %}>{{ label }}</a>
{% endfor %}
</nav>
<details class="site-tools"><summary>更多工具</summary><div class="site-tools-menu">
<a href="{{ prefix }}account.html" data-account-link>登录 / 注册</a>
{% for key,label,file in [('desk','联系准备','desk.html'),('notices','招生通知','notices.html'),('index','全量导师目录','index.html'),('compare','导师对比','compare.html')] %}
<a href="{{ prefix }}{{ file }}" {% if current_page == key %}aria-current="page"{% endif %}>{{ label }}</a>
{% endfor %}
{% if current_page != 'detail' %}<a href="release.html"{% if current_page == 'release' %} aria-current="page"{% endif %}>版本与使用说明</a>{% endif %}<details><summary>历史记录</summary><a href="{{ prefix }}board.html"{% if current_page == 'board' %} aria-current="page"{% endif %}>旧套磁看板</a></details></div></details>
{% if current_page == 'detail' %}<span class="crumb">{{ p.school_name or p.school }} · {{ p.dept_name or p.dept }}</span>{% endif %}
{% if current_page == 'board' %}<span class="muted">跟进中 <b id="tracked">0</b> 人</span>{% endif %}
</div></header>
