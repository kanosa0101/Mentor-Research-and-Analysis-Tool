{% set prefix = '../' if current_page == 'detail' else '' %}
<header class="top site-header"><div class="site-header-inner">
<a class="site-brand" href="{{ prefix }}discovery.html">◈ 导师库 · 申请助手</a>
<nav aria-label="主导航">
{% for key,label,file in [('discovery','找导师','discovery.html'),('admissions','学校与要求','admissions.html'),('notices','招生通知','notices.html'),('desk','我的申请','desk.html')] %}
<a href="{{ prefix }}{{ file }}" {% if current_page == key %}aria-current="page"{% endif %}{% if key == 'desk' and current_page == 'applications' %} id="back-desk"{% endif %}>{{ label }}</a>
{% endfor %}
</nav>
<details class="site-tools"><summary>更多工具</summary><div class="site-tools-menu">
{% for key,label,file in [('index','全量导师目录','index.html'),('compare','导师对比','compare.html'),('applications','项目与材料','applications.html'),('board','旧套磁看板','board.html')] %}
<a href="{{ prefix }}{{ file }}" {% if current_page == key %}aria-current="page"{% endif %}{% if key == 'applications' and current_page == 'desk' %} id="manage-link"{% endif %}>{{ label }}</a>
{% endfor %}
</div></details>
{% if current_page == 'detail' %}<span class="crumb">{{ p.school_name or p.school }} · {{ p.dept_name or p.dept }}</span>{% endif %}
{% if current_page == 'board' %}<span class="muted">跟进中 <b id="tracked">0</b> 人</span>{% endif %}
</div></header>
