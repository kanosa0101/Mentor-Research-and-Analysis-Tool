{% set current_page = 'desk' %}
<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>联系准备 · 导师库</title>
<style>
.message:empty{min-height:0;margin-top:0}
#target-task-list{max-height:280px;overflow:auto}.prepare-links{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}.prepare-links button{flex:1;white-space:nowrap}.prepare-links button[aria-selected="true"]{background:var(--accent);color:white}.context details{margin-top:12px}.context summary{cursor:pointer;color:var(--accent)}.prepare-panels>.panel{margin-top:0}
:root{--paper:#f3f4f0;--card:#fff;--ink:#202c29;--muted:#66746e;--line:#dce3dc;--accent:#275948;--soft:#e8f0e9;--amber:#98601d}*{box-sizing:border-box}[hidden]{display:none!important}
body{margin:0;background:var(--paper);color:var(--ink);font:14px "Segoe UI","Microsoft YaHei",sans-serif}button,input,select,textarea{font:inherit}a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}button{cursor:pointer;padding:9px 13px;border:1px solid var(--line);border-radius:6px;background:white;color:var(--accent)}button:hover{background:var(--soft)}button:disabled{opacity:.5;cursor:default}button.primary{background:var(--accent);color:white;border-color:var(--accent)}button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
header{background:var(--card);border-bottom:1px solid var(--line)}.header-inner{max-width:1320px;padding:18px 28px;margin:auto;display:flex;gap:24px;align-items:center;flex-wrap:wrap}.brand{font-size:17px;font-weight:700;margin-right:auto}.brand:before{content:'◈';margin-right:8px;color:var(--accent)}header a{color:var(--muted);font-size:13px}.version{font:11px Consolas,monospace;color:var(--muted)}
main{max-width:1320px;margin:auto;padding:28px}.eyebrow{text-transform:uppercase;letter-spacing:2px;font:11px Consolas,monospace;color:var(--muted)}h1{font-family:"Palatino Linotype","Songti SC","SimSun",serif;font-size:34px;font-weight:500;margin:6px 0 10px}h2{font-size:19px;margin:0 0 14px}h3{font-size:15px;margin:0 0 8px}p{line-height:1.7}.muted,small{color:var(--muted)}.hero{display:flex;align-items:center;justify-content:space-between;gap:20px}.hero p{margin:0}.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.toolbar .restore{font-size:12px;background:transparent}
.hint{border-left:3px solid var(--amber);padding:12px 16px;background:#fbf4e8;margin:20px 0}.message{min-height:26px;margin-top:14px;white-space:pre-wrap;overflow-wrap:anywhere}.message.error{color:#a32d25}.tabs{display:flex;border-bottom:1px solid var(--line);gap:26px;margin:12px 0 24px}.tabs button{border:0;border-radius:0;background:transparent;padding:12px 2px;color:var(--muted)}.tabs button[aria-selected="true"]{border-bottom:2px solid var(--accent);color:var(--accent);font-weight:600}
fieldset{border:0;padding:0;margin:0;min-width:0}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px}.stat{background:var(--card);padding:18px 22px;border:1px solid var(--line);border-radius:8px}.stat strong{display:block;font:32px "Palatino Linotype",serif;margin-bottom:4px}.columns{display:grid;grid-template-columns:1.1fr 1fr;gap:20px}.panel{padding:22px;background:var(--card);border:1px solid var(--line);border-radius:8px;min-width:0}.panel+.panel{margin-top:18px}.empty{padding:16px 0;color:var(--muted);line-height:1.7}.welcome{padding:25px;background:var(--soft);border:1px solid #cddcce;border-radius:8px;margin-bottom:20px}.welcome p{margin:8px 0 16px}.welcome a{display:inline-block;font-weight:600}
article{padding:15px 0;border-bottom:1px solid var(--line);overflow-wrap:anywhere}article:last-child{border:0}article p{margin:6px 0}.badge{display:inline-block;font-size:11px;padding:3px 8px;border-radius:4px;background:var(--soft);color:var(--accent);margin:0 4px 4px 0}.badge.warn{background:#fbf0dc;color:var(--amber)}.article-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.overdue{color:var(--amber)}.list-tools{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:12px;margin-bottom:14px}
input,select,textarea{padding:10px 11px;background:white;border:1px solid #cfd8d1;border-radius:5px;width:100%;min-width:0;color:var(--ink)}input:focus,textarea:focus,select:focus{outline:2px solid #aec6b7;outline-offset:1px}textarea{resize:vertical;min-height:90px;line-height:1.7}label{font-size:13px;display:block}label input,label select,label textarea{margin-top:6px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.wide{grid-column:1/-1}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.check{display:flex;align-items:center;gap:7px;line-height:1.5}.check input{width:auto;margin:0}.results{display:flex;flex-wrap:wrap;gap:4px;margin:7px 0}.results button{text-align:left;font-size:12px}.choice{margin:8px 0;color:var(--accent)}
.prepare-grid{display:grid;grid-template-columns:300px minmax(0,1fr);gap:20px;align-items:start}.context{background:var(--soft);border-color:#cddcce}.context h2{font-family:"Songti SC","SimSun",serif;font-size:24px;font-weight:500}.context p{margin:8px 0}.context small{display:block;line-height:1.7}.context .progress{border-top:1px solid #cddcce;padding-top:12px;margin-top:15px}.draft-title{display:flex;justify-content:space-between;align-items:center;gap:12px}.draft-title select{max-width:260px}.attachments{display:flex;flex-direction:column;gap:8px;padding:10px 0}.attachments label{font-size:13px}.attachment-state{color:var(--muted);font-size:12px;margin:0 0 10px;overflow-wrap:anywhere}.send-section{border-top:1px solid var(--line);padding-top:18px;margin-top:18px}.send-section input[type=date]{width:170px}.send-section .actions{align-items:center}.history-body{white-space:pre-wrap}.event-time{font:11px Consolas,monospace;color:var(--muted)}.footer{padding:24px 0;color:var(--muted);font-size:12px}.target-selected{border-left:3px solid var(--accent);padding-left:12px}
@media(max-width:800px){.context>.eyebrow{display:none}.context.panel{padding:12px 14px}.context p{margin:4px 0}.context details{margin-top:6px}main{padding:18px 14px}.header-inner{padding:16px 14px;gap:14px}.hero{align-items:flex-start;flex-direction:column}.columns,.prepare-grid{grid-template-columns:1fr}.fields{grid-template-columns:1fr}.wide{grid-column:auto}.panel{padding:17px}.list-tools{grid-template-columns:1fr 1fr}.list-tools input{grid-column:1/-1}.stats{gap:8px}.stat{padding:14px 10px}.stat strong{font-size:27px}.stat span{font-size:12px}.draft-title{align-items:flex-start;flex-direction:column}.draft-title select{max-width:100%}.toolbar{gap:6px}.tabs{gap:24px}.context h2{font-size:22px}}
</style>
{% include '_ui_head.html.j2' %}</head>
<body class="page page-desk">
{% include '_nav.html.j2' %}

<main>
<div class="hero"><div><h1>联系准备</h1><p class="muted">写邮件、记录回复与下一步。项目和材料统一在“我的申请”管理。</p></div><details><summary>备份与恢复</summary><div class="toolbar"><button id="desk-backup" disabled>备份记录</button><button class="restore" id="desk-restore" disabled>恢复备份</button><input id="desk-restore-file" type="file" accept=".json" hidden></div></details></div>
<div id="desk-hint" class="hint">正在读取账号中的申请记录…</div>
<div id="desk-message" class="message" role="status" aria-live="polite"></div>
<p id="incoming-goal" class="muted" hidden></p>
<fieldset id="desk-workspace" disabled>
<nav class="tabs" aria-label="申请视图"><button data-view="today" aria-selected="true">今日待办</button><button data-view="targets" aria-selected="false">我的导师</button><button data-view="prepare" aria-selected="false">联系准备</button></nav>
<div id="welcome" class="welcome" hidden><h2>从一个申请项目开始</h2><p>建立申请项目，加入心仪导师，再选择材料、准备联系。暂时没有年度或招生信息，可以先留空。</p><a id="welcome-manage" href="applications.html">建立项目与整理材料 →</a></div>
<section id="view-today">
<p id="overview-scope" class="muted"></p><div class="stats"><div class="stat"><strong id="stat-due">0</strong><span>今日 / 逾期待办</span></div><div class="stat"><strong id="stat-waiting">0</strong><span>等待导师回复</span></div><div class="stat"><strong id="stat-preparing">0</strong><span>需要调研或准备</span></div></div>
<div class="columns"><section class="panel"><h2>下一步先做这些</h2><div id="task-list"></div><h3>待安排下一步</h3><p class="muted">已回复、需补材料或约谈中，尚无未完成的导师提醒。</p><div id="unplanned-list"></div><h3>未来计划</h3><div id="future-task-list"></div></section><div><section class="panel"><h2>等待回复</h2><div id="waiting-list"></div></section><section class="panel"><h2>继续准备</h2><div id="preparing-list"></div></section></div></div>
</section>
<section id="view-targets" hidden>
<div class="list-tools"><select id="targets-project" aria-label="筛选项目"></select><select id="targets-stage" aria-label="筛选阶段"><option value="">全部阶段</option></select><input id="targets-query" placeholder="搜索导师 / 学校 / 选择理由" aria-label="搜索目标导师"></div>
<div class="columns"><section class="panel"><h2>我的目标导师</h2><div id="target-list"></div></section><section class="panel"><h2>加入目标</h2><form id="target-form"><div class="fields">
<label class="wide">申请项目<select id="target-project" required></select></label>
<div class="wide"><label>导师<input id="target-query" autocomplete="off" placeholder="姓名、学校或导师 ID"></label><div id="target-results" class="results"></div><div id="target-choice" class="choice"></div></div>
<label>优先级<select id="target-priority"><option value="normal">一般</option><option value="high">优先</option><option value="low">暂缓</option></select></label>
<label class="wide">为什么选择这位导师<textarea id="target-reason" placeholder="具体研究交集、想进一步了解的问题"></textarea></label></div><div class="actions"><button class="primary" id="target-save">加入并准备联系</button></div></form><p class="muted"><a id="target-manage" href="applications.html">新建申请项目 / 上传材料 →</a></p></section></div>
</section>
<section id="view-prepare" hidden>
<div id="prepare-empty" class="welcome"><h2>先选择一位目标导师</h2><p>从“我的导师”进入，也可以从导师详情页直接开始。</p><button data-view="targets">选择目标导师 →</button></div>
<div id="prepare-detail" class="prepare-grid" hidden>
<aside class="panel context"><span class="eyebrow">当前导师</span><h2 id="context-name"></h2><p id="context-project"></p><p><span id="context-stage" class="badge"></span><span id="context-priority" class="badge"></span></p><p><small id="context-next"></small></p><button type="button" id="context-task-link" data-panel="tasks">安排 / 查看下一步 →</button><details><summary>背景与阶段管理</summary><small id="context-reason"></small><p><a id="context-profile" href="#">查看官网信息与出处 →</a></p><div class="progress"><small id="context-research"></small><label>联系阶段<select id="context-stage-edit"></select></label><div class="actions"><button id="stage-save">更新阶段</button></div><small>正式申请状态在项目管理中单独维护。</small></div></details></aside>
<div class="prepare-panels">
<nav class="prepare-links" aria-label="联系操作"><button type="button" data-panel="mail" aria-selected="false">写邮件</button><button type="button" data-panel="tasks" aria-selected="false">下一步</button><button type="button" data-panel="reply" aria-selected="false">记回复</button><button type="button" data-panel="history" aria-selected="false">历史</button></nav><section class="panel" id="prepare-tasks" hidden><h2>下一步与提醒</h2><div id="target-task-list"></div><form id="task-form"><div class="fields"><label>提醒内容<input id="task-title" required placeholder="例如：核对报名截止、整理简历"></label><label>计划日期<input id="task-due" type="date" required></label></div><div class="actions"><button id="task-save" class="primary">新增提醒</button><button id="task-reset" type="button">取消编辑 / 清空</button></div><div id="task-status" role="status" aria-live="polite"></div></form></section>
<section class="panel" id="prepare-mail"><div class="draft-title"><h2>准备这一次联系</h2><select id="draft-choice" aria-label="选择历史草稿"></select></div><p class="muted">先核实联系依据，再写邮件。导出 EML 包含所选附件，由你在邮件客户端检查并发送。</p>
<p id="draft-readiness" class="muted" role="status" aria-live="polite"></p><form id="draft-form"><fieldset id="draft-fields"><div class="fields">
<label class="wide">收件邮箱<input id="draft-recipient" placeholder="单个邮箱；有多个候选时请自行核实选择"></label>
<label class="wide">邮件主题<input id="draft-subject"></label>
<label class="wide">联系依据<textarea id="draft-basis" placeholder="导师的具体研究 / 论文与自己的真实项目有什么关联"></textarea></label>
<label class="wide">正文<textarea id="draft-body" rows="9" placeholder="简短介绍自己、具体研究交集、真实经历和希望确认的问题"></textarea></label></div>
<label>本次附件</label><div id="draft-materials" class="attachments"></div><p id="attachment-state" class="attachment-state"></p>
<div class="actions"><button class="primary" id="draft-save">保存草稿</button><button type="button" id="draft-export" disabled>导出邮件与附件</button></div><div id="draft-status" role="status" aria-live="polite"></div></fieldset></form>
<div class="actions"><button id="draft-new" type="button">新建草稿</button><a id="draft-manage" href="applications.html">整理材料 →</a></div>
<div class="send-section"><p id="sent-state" class="muted">草稿和导出不会计为已发送。</p><label class="check"><input id="sent-confirmed" type="checkbox">我已在外部邮件客户端实际发送此版本</label><div class="actions"><input id="sent-date" type="date" aria-label="实际发送日期"><button id="draft-confirm" disabled>确认实际发送</button></div></div>
</section>
<section class="panel" id="prepare-reply" hidden><h2>记录回复与下一步</h2><form id="reply-form"><div class="fields">
<label class="wide">回复内容<textarea id="reply-content" required></textarea></label><label>回复日期<input id="reply-date" type="date" required></label><label>后续阶段<select id="reply-stage"></select></label>
<label>下一步（可选）<input id="reply-task" placeholder="例如：补充研究介绍"></label><label>计划日期<input id="reply-due" type="date"></label></div><div class="actions"><button class="primary" id="reply-save">记录回复与下一步</button></div><div id="reply-status" role="status" aria-live="polite"></div></form></section>
<section class="panel" id="prepare-history" hidden><h2>联系时间线</h2><div id="contact-history"></div></section>
</div></div>
</section>
</fieldset>
<div class="footer">私人记录按账号保存 · 备份不包含附件原文件</div>
</main><script src="contact-data.js?v=20261116-ux1"></script><script src="desk.js?v=20261123-contact-context"></script>
</body></html>
