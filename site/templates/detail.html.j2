<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ p.name }} · 导师库</title>
<style>
:root{
  --bg:#f4f5f7;--card:#fff;--ink:#1a202c;--muted:#718096;--line:#e8eaee;
  --accent:#3b5bdb;--accent-soft:#eef2ff;--ok:#0c8a5b;--warn:#b45309;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:-apple-system,"Segoe UI","Microsoft YaHei","PingFang SC",sans-serif;font-size:14px}
.top{background:linear-gradient(120deg,#1d2b64,#3b5bdb 55%,#5f7ae0);color:#fff;padding:14px 24px}
.top a{color:#cdd9ff;text-decoration:none;font-size:13px}
.top a:hover{color:#fff}
.top .crumb{margin-top:4px;font-size:12.5px;opacity:.85}
.wrap{max-width:980px;margin:22px auto;padding:0 20px 50px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:22px 26px;margin-bottom:16px;
  box-shadow:0 2px 10px rgba(20,30,60,.04)}
.card h2{margin:0 0 2px;font-size:21px}
.card h3{margin:0 0 12px;font-size:14px;color:var(--muted);font-weight:600;letter-spacing:.4px}
img.photo{width:112px;height:150px;object-fit:cover;border-radius:10px;float:right;margin-left:18px;border:1px solid var(--line)}
.dl{display:grid;grid-template-columns:96px 1fr;gap:7px 14px;font-size:13.5px;margin-top:14px}
.dl dt{color:var(--muted)}.dl dl dd{margin:0}
.dl dd{margin:0}
.meta{font-size:11.5px;color:var(--muted);margin-top:14px;display:flex;gap:16px;flex-wrap:wrap}
.tag{display:inline-block;font-size:11px;padding:2px 9px;border-radius:20px;vertical-align:2px;margin-left:8px}
.tag-roster{background:#fef4e0;color:var(--warn)}
.tag-enriched{background:var(--accent-soft);color:var(--accent)}
.tag-verified{background:#e3f7ef;color:var(--ok)}
.pv{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:4px}
.pv th,.pv td{border:1px solid var(--line);padding:7px 10px;text-align:left}
.pv th{background:#fafbfd;color:var(--muted);font-weight:600}
.o-crawled{color:var(--accent)}.o-manual{color:var(--warn)}.o-ai{color:#7c3aed}.o-computed{color:var(--ok)}
.c-auto{color:var(--muted)}.c-verified{color:var(--ok)}.c-unverified{color:#c53030}
.missing{color:#b8bfcc;font-size:12px}
.bio{font-size:13.5px;white-space:pre-wrap;line-height:1.85;color:#333}
a{color:var(--accent);text-decoration:none;word-break:break-all}
a:hover{text-decoration:underline}
.chip{display:inline-block;font-size:11.5px;background:#f1f3f7;color:#556;border-radius:6px;padding:2px 8px;margin:0 4px 2px 0}
</style>
</head>
<body>
<div class="top">
  <a href="../index.html">← 返回列表</a>
  <div class="crumb">{{ p.school_name or p.school }} · {{ p.dept_name or p.dept }}</div>
</div>
<div class="wrap">
<div class="card">
  {% if p.photo_url %}<img class="photo" src="{{ p.photo_url }}" alt="" onerror="this.style.display='none'">{% endif %}
  <h2>{{ p.name }} <span class="tag tag-{{ p.status }}">{{ {"roster":"仅名单","enriched":"已富化","verified":"已核对"}[p.status] or p.status }}</span></h2>
  <div style="color:var(--muted);font-size:13.5px">{{ p.title or "职称：官网未提供" }}</div>
  <dl class="dl">
    <dt>研究所</dt><dd>{{ p.institutes|join("、") or "官网未提供" }}</dd>
    <dt>导师资格</dt><dd>{{ p.supervisor or "官网未提供" }}</dd>
    {% if p.subjects %}<dt>招生学科</dt><dd>{{ p.subjects }}</dd>{% endif %}
    <dt>研究方向</dt><dd>{{ p.research_direction_raw or "官网未提供" }}</dd>
    <dt>邮箱</dt><dd>{{ p.email or "官网未提供" }}</dd>
    <dt>个人主页</dt><dd>{% if p.homepage %}<a href="{{ p.homepage }}" target="_blank">{{ p.homepage }}</a>{% else %}<span class="missing">官网未提供</span>{% endif %}</dd>
    <dt>官网页面</dt><dd><a href="{{ p.profile_url or p.detail_url }}" target="_blank">{{ p.profile_url or p.detail_url }}</a></dd>
  </dl>
  <div class="meta">
    <span>首次入库：{{ p.first_seen or "—" }}</span>
    <span>最近核对：{{ p.last_verified or "—" }}</span>
    {% if p.source_updated_at %}<span>官网数据更新于：{{ p.source_updated_at }}</span>{% endif %}
  </div>
  <div style="clear:both"></div>
</div>
{% if p.bio_raw %}
<div class="card">
  <h3>个人简介（官网原文）</h3>
  <div class="bio">{{ p.bio_raw }}</div>
</div>
{% endif %}
<div class="card">
  <h3>字段出处 · PROVENANCE</h3>
  <table class="pv">
    <tr><th>字段</th><th>值</th><th>origin</th><th>confidence</th><th>抓取日期</th><th>出处</th></tr>
    {% for k, v in p.provenance.items() %}
    <tr>
      <td>{{ k }}</td>
      <td>{{ {
            "name": p.name, "title": p.title, "email": p.email,
            "homepage": p.homepage, "photo_url": p.photo_url,
            "phone": p.phone, "office_address": p.office_address,
            "bio_raw": p.bio_raw|truncate(60), "research_direction_raw": p.research_direction_raw,
            "institutes": p.institutes|join("、"), "detail_url": p.detail_url
          }.get(k, "") or "—" }}</td>
      <td class="o-{{ v.origin }}">{{ v.origin }}</td>
      <td class="c-{{ v.confidence }}">{{ v.confidence }}</td>
      <td>{{ v.fetched_at }}</td>
      <td><a href="{{ v.source }}" target="_blank">原文 ↗</a></td>
    </tr>
    {% endfor %}
  </table>
</div>
</div>
</body>
</html>
