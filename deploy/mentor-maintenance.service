[Unit]
Description=Rotate old public mentor and policy sources and rebuild public pages
After=network-online.target mentor-monitor.service

[Service]
Type=oneshot
User=mentor-assistant
Group=mentor-assistant
WorkingDirectory=/opt/mentor-assistant
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Shanghai
Environment=MENTOR_AI_CONFIG_FILE=%d/ai-config
LoadCredential=ai-config:/opt/mentor-assistant/var/ai/config.json
ExecStart=/opt/mentor-assistant/.venv/bin/python scripts/maintain_public.py
SuccessExitStatus=1
TimeoutStartSec=45min
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/mentor-assistant/data /opt/mentor-assistant/sites /opt/mentor-assistant/cache /opt/mentor-assistant/site
ProtectHome=true
PrivateTmp=true
UMask=0002
